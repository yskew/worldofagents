# development enables local conveniences (ephemeral JWT keys, demo-user auth).
# Set to production to require real RSA keys + Clerk and disable the bypass.
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://agentverify:devpassword@postgres:5432/agentverify
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWKS_URL=https://YOUR-CLERK-DOMAIN.clerk.accounts.dev/.well-known/jwks.json
RSA_PRIVATE_KEY_PEM=
RSA_PUBLIC_KEY_PEM=
JWT_ISSUER=agentverify
JWT_EXPIRY_SECONDS=3600
VERIFICATION_PASS_THRESHOLD=0.7
VERIFICATION_FAIL_THRESHOLD=0.4

# Hardening (RFC 0007)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Signature engine feature flags (RFC 0001-0006). V2 scoring/encoding default on;
# learned weights and calibration ship off pending a real labeled corpus.
SCORE_NORMALIZATION_V2=true
VECTOR_ENCODING_V2=true
USE_LEARNED_WEIGHTS=false
SCORE_CALIBRATION=false

# Active challenge-response verification (RFC 0008). Set CHALLENGE_SECRET to a
# strong random value in production.
CHALLENGE_SECRET=dev-challenge-secret-change-me
CHALLENGE_TTL_SECONDS=120
CHALLENGE_NUM_PROBES=3
ACTIVE_VERIFICATION_PASS_THRESHOLD=0.7

# Token-exchange broker (RFC 0009). OIDC_PROVIDERS_JSON federates external IdPs
# (Okta/Entra/Auth0/Google) ALONGSIDE Clerk, e.g.
# [{"id":"okta","issuer":"https://x.okta.com","jwks_url":"https://x.okta.com/oauth2/v1/keys","audience":"api://woa"}]
DOWNSTREAM_TOKEN_EXPIRY_SECONDS=300
OIDC_PROVIDERS_JSON=
