DATABASE_URL=postgresql+asyncpg://agentverify:devpassword@postgres:5432/agentverify
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWKS_URL=https://YOUR-CLERK-DOMAIN.clerk.accounts.dev/.well-known/jwks.json
RSA_PRIVATE_KEY_PEM=
RSA_PUBLIC_KEY_PEM=
JWT_ISSUER=agentverify
JWT_EXPIRY_SECONDS=3600
VERIFICATION_PASS_THRESHOLD=0.7
VERIFICATION_FAIL_THRESHOLD=0.4

# Shared Signals / CAEP transmitter (RFC 0011). Emit behavioral-risk + revocation
# events as signed SETs for receivers to consume (poll, or push to webhooks).
SSF_ENABLED=true
SSF_RECEIVER_WEBHOOKS=
SSF_AUDIENCE=https://receivers.worldofagents.dev
